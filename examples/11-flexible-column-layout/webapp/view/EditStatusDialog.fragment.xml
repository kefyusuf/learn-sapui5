<core:FragmentDefinition xmlns="sap.m"
						 xmlns:core="sap.ui.core">
	<Dialog id="editStatusDialog"
			title="{i18n>edit.title}"
			contentWidth="20rem">
		<content>
			<VBox class="sapUiSmallMargin">
				<!-- {ui>...}: the dialog's LOCAL JSON model set by the
				     controller. The default model here is OData V4 - binding
				     {/edit/...} against it throws "Failed to read path" (M19).
				     The Select stays UNBOUND: its value is read at save time
				     (getSelectedKey) - one source of truth per control. -->
				<Label text="{i18n>edit.order}" labelFor="editOrderText" />
				<Text id="editOrderText" text="{ui>/edit/order}" />
				<Label text="{i18n>edit.status}" labelFor="editStatusSelect" />
				<Select id="editStatusSelect">
					<items>
						<core:Item key="Open" text="Open" />
						<core:Item key="Processing" text="Processing" />
						<core:Item key="Shipped" text="Shipped" />
					</items>
				</Select>
			</VBox>
		</content>
		<buttons>
			<Button text="{i18n>edit.cancel}" press="onCancelEdit" />
			<Button id="editSave" text="{i18n>edit.save}" type="Emphasized" press="onSaveEdit" />
		</buttons>
	</Dialog>
</core:FragmentDefinition>
