<mvc:View controllerName="learn.fcl.controller.Detail"
		  xmlns="sap.m"
		  xmlns:mvc="sap.ui.core.mvc">

	<Page id="detailPage" title="{i18n>detail.title}">
		<content>
			<VBox class="sapUiSmallMargin">
				<ObjectHeader id="objectHeader"
							  title="{ID}"
							  number="{path: 'Total', formatter: '.formatTotal'}"
							  numberUnit="EUR">
					<attributes>
						<ObjectAttribute title="{i18n>column.customer}" text="{Customer}" />
						<ObjectAttribute title="{i18n>column.status}" text="{Status}" />
					</attributes>
				</ObjectHeader>

				<Toolbar class="sapUiSmallMarginTop">
					<Button id="editStatusButton" text="{i18n>edit.statusButton}" press="onEditStatus" />
				</Toolbar>

				<Title text="{i18n>detail.items}" level="H3" class="sapUiSmallMarginTop" />
				<Table id="itemsTable" items="{Items}">
					<columns>
						<Column><header><Text text="{i18n>column.product}" /></header></Column>
						<Column width="5rem" hAlign="End"><header><Text text="{i18n>column.qty}" /></header></Column>
						<Column width="6rem" hAlign="End"><header><Text text="{i18n>column.price}" /></header></Column>
					</columns>
					<items>
						<!-- type="Active": the default (Inactive) rows swallow
						     press events - itemPress never fires without this. -->
						<ColumnListItem vAlign="Middle" type="Active">
							<cells>
								<Text text="{Product}" />
								<Text text="{Quantity}" />
								<Text text="{path: 'Price', formatter: '.formatTotal'}" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</content>
	</Page>

</mvc:View>
