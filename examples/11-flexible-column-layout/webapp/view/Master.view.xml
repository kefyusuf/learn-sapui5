<mvc:View controllerName="learn.fcl.controller.Master"
		  xmlns="sap.m"
		  xmlns:mvc="sap.ui.core.mvc">

	<Page id="masterPage" title="{i18n>master.title}">
		<content>
			<Table id="ordersTable"
				   items="{path: '/SalesOrders', parameters: { $expand: 'Items' }}"
				   mode="SingleSelectMaster"
				   growing="true">
				<columns>
					<Column width="7rem"><header><Text text="{i18n>column.id}" /></header></Column>
					<Column><header><Text text="{i18n>column.customer}" /></header></Column>
					<Column width="7rem" hAlign="End"><header><Text text="{i18n>column.total}" /></header></Column>
					<Column width="7rem"><header><Text text="{i18n>column.status}" /></header></Column>
				</columns>
				<items>
					<ColumnListItem vAlign="Middle" type="Active">
						<cells>
							<Text text="{ID}" />
							<Text text="{Customer}" />
							<Text text="{path: 'Total', formatter: '.formatTotal'}" />
							<ObjectStatus text="{Status}" state="{path: 'Status', formatter: '.formatStatusState'}" />
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Page>

</mvc:View>
