{
	"_version": "2.0.0",

	"sap.app": {
		"id": "learn.fcl",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"dataSources": {
			"mainService": {
				"uri": "/sap/opu/odata/sap/ZSALESORDERSV4_SRV/",
				"type": "OData",
				"settings": {
					"odataVersion": "4.0",
					"localUri": "localService/metadata.xml"
				}
			}
		}
	},

	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},

	"sap.ui5": {
		"rootView": {
			"viewName": "learn.fcl.view.App",
			"type": "XML",
			"id": "appView"
		},

		"dependencies": {
			"minUI5Version": "1.152.0",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.f": {},
				"sap.ui.layout": {}
			}
		},

		"contentDensities": {
			"compact": true,
			"cozy": true
		},

		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "learn.fcl.i18n.i18n"
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"autoExpandSelect": true,
					"operationMode": "Server"
				}
			}
		},

		"routing": {
			"config": {
				"routerClass": "sap.f.routing.Router",
				"viewType": "XML",
				"path": "learn.fcl.view",
				"controlId": "fcl",
				"controlAggregation": "beginColumnPages"
			},
			"routes": [
				{
					"pattern": "",
					"name": "master",
					"target": "master"
				},
				{
					"pattern": "detail/{orderId}",
					"name": "detail",
					"target": "detail"
				}
			],
			"targets": {
				"master": {
					"type": "View",
					"name": "Master",
					"level": 1
				},
				"detail": {
					"type": "View",
					"name": "Detail",
					"level": 2,
					"controlAggregation": "midColumnPages"
				}
			}
		}
	}
}
