<mvc:View controllerName="learn.mvc.controller.App"
		  displayBlock="true"
		  xmlns="sap.m"
		  xmlns:core="sap.ui.core"
		  xmlns:mvc="sap.ui.core.mvc"
		  xmlns:layout="sap.ui.layout">

	<Page id="page" title="{i18n>appTitle}">
		<content>
			<FlexBox class="sapUiSmallMargin" justifyContent="Center">
				<Panel class="employeeCard" headerText="{i18n>welcomeCard.title}">
					<FlexBox class="sapUiSmallMargin" alignItems="Center">
						<Image src="https://ui5.sap.com/resources/sap/images/dummy/Portrait.png"
							   width="6rem" height="6rem"
							   alt="Employee portrait" />
						<VBox class="sapUiMediumMarginBegin">
							<Text text="{i18n>label.name}: Maria Kaya" />
							<Text text="{i18n>label.department}: {/employee/department}" />
							<Text text="{i18n>label.role}: {/employee/role}" />
							<Text text="{i18n>label.startDate}: {/employee/startDate}" />
						</VBox>
					</FlexBox>

					<layout:VerticalLayout class="sapUiSmallMargin sapUiMediumMarginTop">
						<core:Icon src="sap-icon://employee" size="1.2rem" color="#0a6ed1" />
						<Text text="{i18n>detailsPanel}" class="sapUiTinyMarginTop" />
					</layout:VerticalLayout>

					<Button text="{i18n>greetButton}" press="onSayHi" class="sapUiSmallMargin" />
				</Panel>
			</FlexBox>
		</content>
	</Page>

</mvc:View>
