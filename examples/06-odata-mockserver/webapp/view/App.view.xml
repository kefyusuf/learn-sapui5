<mvc:View controllerName="learn.odata.controller.App"
		  displayBlock="true"
		  xmlns="sap.m"
		  xmlns:mvc="sap.ui.core.mvc"
		  xmlns:f="sap.ui.layout.form"
		  xmlns:core="sap.ui.core">

	<Page id="page" title="{i18n>appTitle}">
		<content>
			<VBox class="sapUiSmallMargin">

				<!-- The OData list binding. Note the path "/SalesOrderSet" -
				     entity sets, not tables, are the entry point of OData. -->
				<Table id="ordersTable"
					   items="{path: '/SalesOrderSet', parameters: { expand: 'Items' }}"
					   mode="SingleSelectMaster"
					   selectionChange="onOrderSelected"
					   growing="true">
					<headerToolbar>
						<Toolbar>
							<Title text="{i18n>orders.title}" level="H4" />
						</Toolbar>
					</headerToolbar>
					<columns>
						<Column width="7rem"><header><Text text="{i18n>column.id}" /></header></Column>
						<Column><header><Text text="{i18n>column.customer}" /></header></Column>
						<Column width="7rem" hAlign="End"><header><Text text="{i18n>column.total}" /></header></Column>
						<Column width="7rem"><header><Text text="{i18n>column.status}" /></header></Column>
					</columns>
					<items>
						<ColumnListItem vAlign="Middle" type="Active">
							<cells>
								<Text text="{ID}" />
								<Text text="{Customer}" />
								<Text text="{path: 'Total', formatter: '.formatTotal'}" />
								<ObjectStatus text="{Status}" state="{path: 'Status', formatter: '.formatStatusState'}" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>

				<Panel headerText="{i18n>detail.items}" class="sapUiSmallMarginTop"
					   visible="{= ${/selectedPath} !== '' }">
					<!-- Relative binding: this table shows {Items} of whatever
					     order the view is bound to (set by bindElement). -->
					<Table items="{Items}">
						<columns>
							<Column><header><Text text="{i18n>column.product}" /></header></Column>
							<Column width="5rem" hAlign="End"><header><Text text="{i18n>column.qty}" /></header></Column>
							<Column width="6rem" hAlign="End"><header><Text text="{i18n>column.price}" /></header></Column>
						</columns>
						<items>
							<ColumnListItem vAlign="Middle">
								<cells>
									<Text text="{Product}" />
									<Text text="{Quantity}" />
									<Text text="{path: 'Price', formatter: '.formatTotal'}" />
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</Panel>

				<Text text="{i18n>detail.select}" visible="{= ${/selectedPath} === '' }" class="sapUiSmallMarginTop" />

			</VBox>
		</content>
	</Page>

</mvc:View>
