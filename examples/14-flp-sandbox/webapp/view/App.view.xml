		  xmlns="sap.m"
		  xmlns:mvc="sap.ui.core.mvc">

	<App>
		<Page id="page" title="{i18n>page.title}">
			<content>
				<VBox class="sapUiSmallMargin">
					<Title text="{i18n>hello.title}" level="H3" />
