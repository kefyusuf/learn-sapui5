<mvc:View controllerName="learn.realodata.controller.App"
		  displayBlock="true"
		  xmlns="sap.m"
		  xmlns:mvc="sap.ui.core.mvc">

	<Page id="page" title="{i18n>appTitle}">
		<subHeader>
			<Toolbar>
				<SearchField id="searchField"
							 placeholder="{i18n>search.placeholder}"
							 liveChange="onSearch"
							 width="100%" />
			</Toolbar>
		</subHeader>
		<content>
			<Table id="productsTable"
				   headerText="{i18n>products.title}"
				   items="{path: '/Products', parameters: { expand: 'Category' }}"
				   growing="true"
				   growingThreshold="10"
				   noDataText="Loading products...">
				<columns>
					<Column><header><Text text="{i18n>column.product}" /></header></Column>
					<Column width="9rem"><header><Text text="{i18n>column.category}" /></header></Column>
					<Column width="7rem" hAlign="End"><header><Text text="{i18n>column.price}" /></header></Column>
					<Column width="9rem"><header><Text text="{i18n>column.stock}" /></header></Column>
				</columns>
				<items>
					<ColumnListItem vAlign="Middle">
						<cells>
							<Text text="{ProductName}" />
							<Text text="{Category/CategoryName}" />
							<Text text="{path: 'UnitPrice', formatter: '.formatPrice'}" />
							<ObjectStatus text="{
								parts: [ { path: 'UnitsInStock' }, { path: 'Discontinued' } ],
								formatter: '.formatStockText'
							}" state="{
								parts: [ { path: 'UnitsInStock' }, { path: 'Discontinued' } ],
								formatter: '.formatStockState'
							}" />
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Page>

</mvc:View>
