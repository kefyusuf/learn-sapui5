<mvc:View controllerName="learn.v4messages.controller.App"
		  displayBlock="true"
		  xmlns="sap.m"
		  xmlns:mvc="sap.ui.core.mvc">

	<App>
		<Page id="page" title="{i18n>appTitle}">
			<content>
				<Table id="ordersTable" items="{/SalesOrders}" noDataText="No orders">
					<headerToolbar>
						<Toolbar>
							<Title text="{i18n>table.title}" level="H2" />
							<ToolbarSpacer />
							<Button id="newOrderButton" text="{i18n>neworder.button}" press="onNewOrder" />
							<Button id="messageButton"
									icon="sap-icon://message-popup"
									text=""
									tooltip="{i18n>messages.button.tooltip}"
									press="onMessagePopoverPress" />
						</Toolbar>
					</headerToolbar>
					<columns>
						<Column><header><Text text="{i18n>column.id}" /></header></Column>
						<Column><header><Text text="{i18n>column.customer}" /></header></Column>
						<Column><header><Text text="{i18n>column.status}" /></header></Column>
						<Column hAlign="End"><header><Text text="{i18n>column.total}" /></header></Column>
					</columns>
					<items>
						<ColumnListItem vAlign="Middle">
							<cells>
								<Text text="{ID}" />
								<Text text="{Customer}" />
								<Text text="{Status}" />
								<Text text="{Total}" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</content>
		</Page>
	</App>

</mvc:View>
