<core:FragmentDefinition xmlns="sap.m"
						 xmlns:core="sap.ui.core">
	<Dialog id="editStatusDialog"
			title="{i18n>edit.title}"
			contentWidth="20rem">
		<content>
			<VBox class="sapUiSmallMargin">
				<Label text="{i18n>edit.id}" labelFor="editIdText" />
				<Text id="editIdText" text="{/edit/id}" />
				<Label text="{i18n>edit.status}" labelFor="editStatusSelect" />
				<Select id="editStatusSelect" selectedKey="{/edit/status}">
					<items>
						<core:Item key="Annual" text="Annual" />
						<core:Item key="Sick" text="Sick" />
						<core:Item key="Unpaid" text="Unpaid" />
					</items>
				</Select>
			</VBox>
		</content>
		<buttons>
			<Button text="{i18n>edit.cancel}" press="onCancelEdit" />
			<Button id="editSave" text="{i18n>edit.save}" type="Emphasized" press="onSaveEdit" />
		</buttons>
	</Dialog>
</core:FragmentDefinition>
